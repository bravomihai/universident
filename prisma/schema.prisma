// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id
  name                     String
  email                    String
  emailVerified            Boolean             @default(false)
  role                     UserRole            @default(PATIENT)
  image                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  studentProfile           StudentProfile?
  patientProfile           PatientProfile?
  appointmentStatusChanges Appointment[]       @relation("AppointmentStatusChangedBy")
  appointmentNotifications AppointmentNotification[]
  reviewsAuthored          AppointmentReview[] @relation("AppointmentReviewAuthor")
  reviewsReceived          AppointmentReview[] @relation("AppointmentReviewTarget")

  @@unique([email])
  @@map("user")
}

model StudentProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  publicSlug  String?   @unique
  university  String
  studyYear   Int
  bio         String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations          StudentLocation[]
  supervisors        StudentSupervisor[]
  studentTreatments  StudentTreatment[]
  availabilitySeries StudentAvailabilitySeries[]
  availabilitySlots  StudentAvailabilitySlot[]
  appointments       Appointment[]

  @@index([isPublished, publicSlug])
  @@map("student_profile")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  profileSlug String    @unique
  dateOfBirth DateTime? @db.Date
  bio         String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patient_profile")
}

model University {
  id        String   @id @default(cuid())
  slug      String   @unique
  shortName String   @unique
  fullName  String
  city      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder, shortName])
  @@map("university")
}

model StudentLocation {
  id               String    @id @default(cuid())
  studentProfileId String
  cityId           String
  routeKey         String
  name             String
  address          String
  details          String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile     StudentProfile              @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  city               City                        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  availabilitySeries StudentAvailabilitySeries[]
  availabilitySlots  StudentAvailabilitySlot[]

  @@unique([id, studentProfileId])
  @@unique([studentProfileId, routeKey])
  @@index([studentProfileId, deletedAt])
  @@index([cityId, deletedAt, studentProfileId])
  @@map("student_location")
}

model StudentTreatment {
  id               String    @id @default(cuid())
  studentProfileId String
  treatmentId      String
  description      String?
  durationMinutes  Int
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile  StudentProfile                      @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  treatment       Treatment                           @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  seriesOfferings StudentAvailabilitySeriesOffering[]
  slotOfferings   StudentAvailabilitySlotOffering[]

  @@unique([studentProfileId, treatmentId])
  @@unique([id, studentProfileId])
  @@index([studentProfileId, deletedAt])
  @@index([treatmentId, deletedAt, studentProfileId])
  @@map("student_treatment")
}

model StudentSupervisor {
  id               String    @id @default(cuid())
  studentProfileId String
  fullName         String
  academicTitle    String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile  StudentProfile                      @relation(fields: [studentProfileId], references: [id], onDelete: Restrict, map: "student_supervisor_student_profile_fkey")
  seriesOfferings StudentAvailabilitySeriesOffering[]
  slotOfferings   StudentAvailabilitySlotOffering[]

  @@unique([id, studentProfileId])
  @@index([studentProfileId, deletedAt])
  @@map("student_supervisor")
}

model StudentAvailabilitySeries {
  id                  String                          @id @default(cuid())
  studentProfileId    String
  studentLocationId   String
  timeZone            String                          @default("Europe/Bucharest") @db.VarChar(64)
  startsOn            DateTime                        @db.Date
  startMinuteOfDay    Int
  weekdays            StudentAvailabilityWeekday[]
  intervalWeeks       Int
  durationMinutes     Int
  endMode             StudentAvailabilityEndMode
  endsOn              DateTime?                       @db.Date
  occurrenceCount     Int?
  status              StudentAvailabilitySeriesStatus @default(ACTIVE)
  materializedThrough DateTime?                       @db.Date
  revision            Int                             @default(1)
  createdAt           DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                        @updatedAt @db.Timestamptz(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict, map: "student_availability_series_student_profile_fkey")

  studentLocation StudentLocation @relation(fields: [studentLocationId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_availability_series_location_owner_fkey")

  slots     StudentAvailabilitySlot[]           @relation("AvailabilitySeriesSlots")
  offerings StudentAvailabilitySeriesOffering[]

  @@unique([id, studentProfileId])
  @@unique([id, studentProfileId, studentLocationId], map: "student_availability_series_id_owner_location_key")
  @@index([studentProfileId, status, startsOn], map: "student_availability_series_owner_status_starts_idx")
  @@index([studentLocationId, status, startsOn], map: "student_availability_series_location_status_starts_idx")
  @@index([status, materializedThrough], map: "student_availability_series_status_materialized_idx")
  @@map("student_availability_series")
}

model StudentAvailabilitySeriesOffering {
  id                 String   @id @default(cuid())
  seriesId           String
  studentProfileId   String
  studentTreatmentId String
  supervisorId       String
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  series           StudentAvailabilitySeries @relation(fields: [seriesId, studentProfileId], references: [id, studentProfileId], onDelete: Cascade, map: "availability_series_offering_series_owner_fkey")
  studentTreatment StudentTreatment          @relation(fields: [studentTreatmentId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "availability_series_offering_treatment_owner_fkey")
  supervisor       StudentSupervisor         @relation(fields: [supervisorId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "availability_series_offering_supervisor_owner_fkey")

  @@unique([seriesId, studentTreatmentId])
  @@index([studentTreatmentId, seriesId])
  @@index([supervisorId, seriesId])
  @@map("student_availability_series_offering")
}

model StudentAvailabilitySlot {
  id                String                        @id @default(cuid())
  studentProfileId  String
  studentLocationId String
  seriesId          String?
  sequenceNumber    Int?
  originalStartsAt  DateTime                      @db.Timestamptz(3)
  startsAt          DateTime                      @db.Timestamptz(3)
  endsAt            DateTime                      @db.Timestamptz(3)
  status            StudentAvailabilitySlotStatus @default(ACTIVE)
  isException       Boolean                       @default(false)
  sourceRevision    Int                           @default(0)
  version           Int                           @default(1)
  cancelledAt       DateTime?                     @db.Timestamptz(3)
  createdAt         DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                      @updatedAt @db.Timestamptz(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict, map: "student_availability_slot_student_profile_fkey")

  studentLocation StudentLocation @relation(fields: [studentLocationId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_availability_slot_location_owner_fkey")

  series StudentAvailabilitySeries? @relation("AvailabilitySeriesSlots", fields: [seriesId, studentProfileId, studentLocationId], references: [id, studentProfileId, studentLocationId], onDelete: Restrict, map: "student_availability_slot_series_owner_fkey")

  offerings    StudentAvailabilitySlotOffering[]
  appointments Appointment[]

  @@unique([id, studentProfileId])
  @@unique([seriesId, originalStartsAt], map: "student_availability_slot_series_original_start_key")
  @@index([studentProfileId, status, startsAt], map: "student_availability_slot_owner_status_starts_idx")
  @@index([studentLocationId, status, startsAt], map: "student_availability_slot_location_status_starts_idx")
  @@index([seriesId, sequenceNumber], map: "student_availability_slot_series_sequence_idx")
  @@map("student_availability_slot")
}

model StudentAvailabilitySlotOffering {
  id                 String    @id @default(cuid())
  slotId             String
  studentProfileId   String
  studentTreatmentId String
  supervisorId       String
  removedAt          DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  slot             StudentAvailabilitySlot @relation(fields: [slotId, studentProfileId], references: [id, studentProfileId], onDelete: Cascade, map: "availability_slot_offering_slot_owner_fkey")
  studentTreatment StudentTreatment        @relation(fields: [studentTreatmentId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "availability_slot_offering_treatment_owner_fkey")
  supervisor       StudentSupervisor       @relation(fields: [supervisorId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "availability_slot_offering_supervisor_owner_fkey")
  appointments     Appointment[]

  @@unique([id, slotId])
  @@index([slotId, studentTreatmentId, removedAt])
  @@index([studentTreatmentId, slotId])
  @@index([supervisorId, slotId])
  @@map("student_availability_slot_offering")
}

model Appointment {
  id                                String            @id @default(cuid())
  routeSlug                         String            @unique
  patientProfileId                  String
  studentProfileId                  String
  studentAvailabilitySlotId         String
  studentAvailabilitySlotOfferingId String
  scheduledStartsAt                 DateTime          @db.Timestamptz(3)
  scheduledEndsAt                   DateTime          @db.Timestamptz(3)
  patientAgeAtAppointment           Int
  patientNote                       String?
  patientNameSnapshot               String            @db.VarChar(120)
  studentNameSnapshot               String            @db.VarChar(120)
  treatmentNameSnapshot             String            @db.VarChar(160)
  locationNameSnapshot              String            @db.VarChar(160)
  locationAddressSnapshot           String            @db.VarChar(240)
  supervisorNameSnapshot            String            @db.VarChar(200)
  status                            AppointmentStatus @default(PENDING)
  pendingExpiresAt                  DateTime?         @db.Timestamptz(3)
  idempotencyKeyHash                String?           @unique @db.Char(64)
  idempotencyRequestHash            String?           @db.Char(64)
  version                           Int               @default(1)
  statusReason                      String?           @db.VarChar(500)
  statusReasonCode                  String?           @db.VarChar(64)
  statusChangedAt                   DateTime          @default(now()) @db.Timestamptz(3)
  statusChangedByUserId             String?
  isLateCancellation                Boolean           @default(false)
  confirmedAt                       DateTime?         @db.Timestamptz(3)
  rejectedAt                        DateTime?         @db.Timestamptz(3)
  cancelledAt                       DateTime?         @db.Timestamptz(3)
  expiredAt                         DateTime?         @db.Timestamptz(3)
  completedAt                       DateTime?         @db.Timestamptz(3)
  noShowAt                          DateTime?         @db.Timestamptz(3)
  createdAt                         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime          @updatedAt @db.Timestamptz(3)

  patientProfile       PatientProfile                  @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  studentProfile       StudentProfile                  @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  availabilitySlot     StudentAvailabilitySlot         @relation(fields: [studentAvailabilitySlotId], references: [id], onDelete: Restrict)
  availabilityOffering StudentAvailabilitySlotOffering @relation(fields: [studentAvailabilitySlotOfferingId, studentAvailabilitySlotId], references: [id, slotId], onDelete: Restrict)
  statusChangedByUser  User?                           @relation("AppointmentStatusChangedBy", fields: [statusChangedByUserId], references: [id], onDelete: SetNull)
  reviews              AppointmentReview[]
  notifications        AppointmentNotification[]

  @@index([patientProfileId, status, scheduledStartsAt])
  @@index([status, pendingExpiresAt], map: "appointment_status_pending_expiry_idx")
  @@index([patientProfileId, status, pendingExpiresAt], map: "appointment_patient_status_pending_expiry_idx")
  @@index([studentProfileId, status, scheduledStartsAt])
  @@index([studentAvailabilitySlotId, status])
  @@index([studentAvailabilitySlotOfferingId, status])
  @@map("appointment")
}

model AppointmentNotification {
  id              String    @id @default(cuid())
  appointmentId   String
  recipientUserId String
  eventType       String    @db.VarChar(64)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  recipient   User        @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, createdAt])
  @@index([appointmentId, recipientUserId])
  @@map("appointment_notification")
}

model AppointmentReview {
  id            String                      @id @default(cuid())
  appointmentId String
  authorUserId  String
  targetUserId  String
  authorRole    AppointmentReviewAuthorRole
  rating        Int
  comment       String?                     @db.VarChar(1000)
  submittedAt   DateTime                    @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?                   @db.Timestamptz(3)
  createdAt     DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  author      User        @relation("AppointmentReviewAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  target      User        @relation("AppointmentReviewTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, authorUserId])
  @@index([targetUserId, publishedAt])
  @@map("appointment_review")
}

model Treatment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentTreatments StudentTreatment[]

  @@map("treatment")
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentLocations StudentLocation[]

  @@map("city")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum UserRole {
  PATIENT
  STUDENT
  ADMIN
}

enum StudentAvailabilityWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StudentAvailabilityEndMode {
  NEVER
  UNTIL
  COUNT
}

enum StudentAvailabilitySeriesStatus {
  ACTIVE
  CANCELLED
}

enum StudentAvailabilitySlotStatus {
  ACTIVE
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  SUPERSEDED
  EXPIRED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_STUDENT
  COMPLETED
  NO_SHOW
}

enum AppointmentReviewAuthorRole {
  PATIENT
  STUDENT
}
