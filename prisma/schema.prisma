// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id
  name                       String
  email                      String
  emailVerified              Boolean                     @default(false)
  role                       UserRole                    @default(PATIENT)
  image                      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  sessions                   Session[]
  accounts                   Account[]
  studentProfile             StudentProfile?
  studentVerificationReviews StudentVerificationReview[] @relation("StudentVerificationReviewer")

  @@unique([email])
  @@map("user")
}

model StudentProfile {
  id                         String                    @id @default(cuid())
  userId                     String                    @unique
  publicSlug                 String?                   @unique
  university                 String
  studyYear                  Int
  bio                        String?
  verificationStatus         StudentVerificationStatus @default(NOT_SUBMITTED)
  submittedForVerificationAt DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations           StudentLocation[]
  studentTreatments   StudentTreatment[]
  verificationReviews StudentVerificationReview[]

  @@index([verificationStatus, submittedForVerificationAt])
  @@map("student_profile")
}

model StudentVerificationReview {
  id               String                      @id @default(cuid())
  studentProfileId String
  reviewerId       String
  decision         StudentVerificationDecision
  reason           String?
  createdAt        DateTime                    @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("StudentVerificationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([studentProfileId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("student_verification_review")
}

model StudentLocation {
  id               String    @id @default(cuid())
  studentProfileId String
  cityId           String
  routeKey         String
  name             String
  address          String
  details          String?
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile     StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  city               City                       @relation(fields: [cityId], references: [id], onDelete: Restrict)
  treatmentLocations StudentTreatmentLocation[]

  @@unique([id, studentProfileId])
  @@unique([studentProfileId, routeKey])
  @@index([studentProfileId, deletedAt, isActive])
  @@index([cityId, deletedAt, isActive, studentProfileId])
  @@map("student_location")
}

model StudentTreatment {
  id               String    @id @default(cuid())
  studentProfileId String
  treatmentId      String
  description      String?
  durationMinutes  Int
  isActive         Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile     StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  treatment          Treatment                  @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  treatmentLocations StudentTreatmentLocation[]

  @@unique([studentProfileId, treatmentId])
  @@unique([id, studentProfileId])
  @@index([studentProfileId, deletedAt, isActive])
  @@index([treatmentId, deletedAt, isActive, studentProfileId])
  @@map("student_treatment")
}

model StudentTreatmentLocation {
  id                 String    @id @default(cuid())
  studentProfileId   String
  studentTreatmentId String
  studentLocationId  String
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentTreatment StudentTreatment @relation(fields: [studentTreatmentId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_treatment_location_treatment_owner_fkey")

  studentLocation StudentLocation @relation(fields: [studentLocationId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_treatment_location_location_owner_fkey")

  @@unique([studentTreatmentId, studentLocationId])
  @@unique([id, studentProfileId])
  @@index([studentProfileId, deletedAt, isActive])
  @@index([studentTreatmentId, deletedAt, isActive])
  @@index([studentLocationId, deletedAt, isActive])
  @@map("student_treatment_location")
}

model Treatment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentTreatments StudentTreatment[]

  @@map("treatment")
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentLocations StudentLocation[]

  @@map("city")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum UserRole {
  PATIENT
  STUDENT
  ADMIN
}

enum StudentVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum StudentVerificationDecision {
  APPROVED
  REJECTED
}
