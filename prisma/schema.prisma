// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id
  name                     String
  email                    String
  emailVerified            Boolean             @default(false)
  role                     UserRole            @default(PATIENT)
  image                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  studentProfile           StudentProfile?
  patientProfile           PatientProfile?
  appointmentStatusChanges Appointment[]       @relation("AppointmentStatusChangedBy")
  reviewsAuthored          AppointmentReview[] @relation("AppointmentReviewAuthor")
  reviewsReceived          AppointmentReview[] @relation("AppointmentReviewTarget")

  @@unique([email])
  @@map("user")
}

model StudentProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  publicSlug  String?   @unique
  university  String
  studyYear   Int
  bio         String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations            StudentLocation[]
  supervisors          StudentSupervisor[]
  studentTreatments    StudentTreatment[]
  availabilitySeries   StudentAvailabilitySeries[]
  availabilitySlots    StudentAvailabilitySlot[]
  appointments         Appointment[]

  @@index([isPublished, publicSlug])
  @@map("student_profile")
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  profileSlug String    @unique
  dateOfBirth DateTime? @db.Date
  bio         String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patient_profile")
}

model StudentLocation {
  id               String    @id @default(cuid())
  studentProfileId String
  cityId           String
  routeKey         String
  name             String
  address          String
  details          String?
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile     StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  city               City                       @relation(fields: [cityId], references: [id], onDelete: Restrict)
  treatmentLocations StudentTreatmentLocation[]

  @@unique([id, studentProfileId])
  @@unique([studentProfileId, routeKey])
  @@index([studentProfileId, deletedAt, isActive])
  @@index([cityId, deletedAt, isActive, studentProfileId])
  @@map("student_location")
}

model StudentTreatment {
  id               String    @id @default(cuid())
  studentProfileId String
  treatmentId      String
  description      String?
  durationMinutes  Int
  isActive         Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile     StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  treatment          Treatment                  @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  treatmentLocations StudentTreatmentLocation[]

  @@unique([studentProfileId, treatmentId])
  @@unique([id, studentProfileId])
  @@index([studentProfileId, deletedAt, isActive])
  @@index([treatmentId, deletedAt, isActive, studentProfileId])
  @@map("student_treatment")
}

model StudentSupervisor {
  id               String    @id @default(cuid())
  studentProfileId String
  fullName         String
  academicTitle    String?
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile     StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Restrict, map: "student_supervisor_student_profile_fkey")
  treatmentLocations StudentTreatmentLocation[]

  @@unique([id, studentProfileId])
  @@index([studentProfileId, deletedAt, isActive])
  @@map("student_supervisor")
}

model StudentTreatmentLocation {
  id                 String    @id @default(cuid())
  studentProfileId   String
  studentTreatmentId String
  studentLocationId  String
  supervisorId       String    @map("supervisor_id")
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentTreatment StudentTreatment @relation(fields: [studentTreatmentId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_treatment_location_treatment_owner_fkey")

  studentLocation StudentLocation @relation(fields: [studentLocationId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_treatment_location_location_owner_fkey")

  supervisor StudentSupervisor @relation(fields: [supervisorId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_treatment_location_supervisor_owner_fkey")

  availabilitySeries StudentAvailabilitySeries[]
  availabilitySlots  StudentAvailabilitySlot[]

  @@unique([id, studentProfileId])
  @@index([studentTreatmentId, studentLocationId])
  @@index([studentProfileId, deletedAt, isActive])
  @@index([studentTreatmentId, deletedAt, isActive])
  @@index([studentLocationId, deletedAt, isActive])
  @@index([supervisorId, deletedAt, isActive])
  @@map("student_treatment_location")
}

model StudentAvailabilitySeries {
  id                         String                           @id @default(cuid())
  studentProfileId           String
  studentTreatmentLocationId String
  timeZone                   String                           @default("Europe/Bucharest") @db.VarChar(64)
  startsOn                   DateTime                         @db.Date
  startMinuteOfDay           Int
  weekdays                   StudentAvailabilityWeekday[]
  intervalWeeks              Int
  durationMinutes            Int
  endMode                    StudentAvailabilityEndMode
  endsOn                     DateTime?                        @db.Date
  occurrenceCount            Int?
  status                     StudentAvailabilitySeriesStatus @default(ACTIVE)
  materializedThrough        DateTime?                        @db.Date
  revision                   Int                              @default(1)
  createdAt                  DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                         @updatedAt @db.Timestamptz(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict, map: "student_availability_series_student_profile_fkey")

  treatmentLocation StudentTreatmentLocation @relation(fields: [studentTreatmentLocationId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_availability_series_treatment_location_owner_fkey")

  slots StudentAvailabilitySlot[] @relation("AvailabilitySeriesSlots")

  @@unique([id, studentProfileId, studentTreatmentLocationId], map: "student_availability_series_id_owner_association_key")
  @@index([studentProfileId, status, startsOn], map: "student_availability_series_owner_status_starts_idx")
  @@index([studentTreatmentLocationId, status, startsOn], map: "student_availability_series_association_status_starts_idx")
  @@index([status, materializedThrough], map: "student_availability_series_status_materialized_idx")
  @@map("student_availability_series")
}

model StudentAvailabilitySlot {
  id                         String                         @id @default(cuid())
  studentProfileId           String
  studentTreatmentLocationId String
  seriesId                   String?
  sequenceNumber             Int?
  originalStartsAt           DateTime                       @db.Timestamptz(3)
  startsAt                   DateTime                       @db.Timestamptz(3)
  endsAt                     DateTime                       @db.Timestamptz(3)
  status                     StudentAvailabilitySlotStatus @default(ACTIVE)
  isException                Boolean                        @default(false)
  sourceRevision             Int                            @default(0)
  version                    Int                            @default(1)
  cancelledAt                DateTime?                      @db.Timestamptz(3)
  createdAt                  DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                       @updatedAt @db.Timestamptz(3)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict, map: "student_availability_slot_student_profile_fkey")

  treatmentLocation StudentTreatmentLocation @relation(fields: [studentTreatmentLocationId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "student_availability_slot_treatment_location_owner_fkey")

  series StudentAvailabilitySeries? @relation("AvailabilitySeriesSlots", fields: [seriesId, studentProfileId, studentTreatmentLocationId], references: [id, studentProfileId, studentTreatmentLocationId], onDelete: Restrict, map: "student_availability_slot_series_owner_fkey")

  appointments Appointment[]

  @@unique([seriesId, originalStartsAt], map: "student_availability_slot_series_original_start_key")
  @@index([studentProfileId, status, startsAt], map: "student_availability_slot_owner_status_starts_idx")
  @@index([studentTreatmentLocationId, status, startsAt], map: "student_availability_slot_association_status_starts_idx")
  @@index([seriesId, sequenceNumber], map: "student_availability_slot_series_sequence_idx")
  @@map("student_availability_slot")
}

model Appointment {
  id                        String            @id @default(cuid())
  routeSlug                 String            @unique
  patientProfileId          String
  studentProfileId          String
  studentAvailabilitySlotId String
  scheduledStartsAt         DateTime          @db.Timestamptz(3)
  scheduledEndsAt           DateTime          @db.Timestamptz(3)
  patientAgeAtAppointment   Int
  patientNote               String?
  patientNameSnapshot       String            @db.VarChar(120)
  studentNameSnapshot       String            @db.VarChar(120)
  treatmentNameSnapshot     String            @db.VarChar(160)
  locationNameSnapshot      String            @db.VarChar(160)
  locationAddressSnapshot   String            @db.VarChar(240)
  supervisorNameSnapshot    String            @db.VarChar(200)
  status                    AppointmentStatus @default(PENDING)
  version                   Int               @default(1)
  statusReason              String?           @db.VarChar(500)
  statusReasonCode          String?           @db.VarChar(64)
  statusChangedAt           DateTime          @default(now()) @db.Timestamptz(3)
  statusChangedByUserId     String?
  isLateCancellation        Boolean           @default(false)
  confirmedAt               DateTime?         @db.Timestamptz(3)
  rejectedAt                DateTime?         @db.Timestamptz(3)
  cancelledAt               DateTime?         @db.Timestamptz(3)
  expiredAt                 DateTime?         @db.Timestamptz(3)
  completedAt               DateTime?         @db.Timestamptz(3)
  noShowAt                  DateTime?         @db.Timestamptz(3)
  createdAt                 DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime          @updatedAt @db.Timestamptz(3)

  patientProfile      PatientProfile           @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  studentProfile      StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  availabilitySlot    StudentAvailabilitySlot  @relation(fields: [studentAvailabilitySlotId], references: [id], onDelete: Restrict)
  statusChangedByUser User?                     @relation("AppointmentStatusChangedBy", fields: [statusChangedByUserId], references: [id], onDelete: SetNull)
  reviews             AppointmentReview[]

  @@index([patientProfileId, status, scheduledStartsAt])
  @@index([studentProfileId, status, scheduledStartsAt])
  @@index([studentAvailabilitySlotId, status])
  @@map("appointment")
}

model AppointmentReview {
  id            String                      @id @default(cuid())
  appointmentId String
  authorUserId  String
  targetUserId  String
  authorRole    AppointmentReviewAuthorRole
  rating        Int
  comment       String?                     @db.VarChar(1000)
  submittedAt   DateTime                    @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?                   @db.Timestamptz(3)
  createdAt     DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  author      User        @relation("AppointmentReviewAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  target      User        @relation("AppointmentReviewTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, authorUserId])
  @@index([targetUserId, publishedAt])
  @@map("appointment_review")
}

model Treatment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentTreatments StudentTreatment[]

  @@map("treatment")
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentLocations StudentLocation[]

  @@map("city")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum UserRole {
  PATIENT
  STUDENT
  ADMIN
}

enum StudentAvailabilityWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StudentAvailabilityEndMode {
  NEVER
  UNTIL
  COUNT
}

enum StudentAvailabilitySeriesStatus {
  ACTIVE
  CANCELLED
}

enum StudentAvailabilitySlotStatus {
  ACTIVE
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  SUPERSEDED
  EXPIRED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_STUDENT
  COMPLETED
  NO_SHOW
}

enum AppointmentReviewAuthorRole {
  PATIENT
  STUDENT
}
