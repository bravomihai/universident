# Folosit doar de compose.yaml pentru PostgreSQL local.
POSTGRES_PASSWORD=replace_with_a_secure_password

# În producție folosește conexiune TLS și endpoint pooled dacă platforma este serverless.
DATABASE_URL=postgresql://universident:replace_with_a_secure_password@localhost:5432/universident?schema=public

# Originea exactă a aplicației. În producție trebuie să fie URL-ul HTTPS final.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret

# Obligatorii în producție pentru verificarea emailului și resetarea parolei.
RESEND_API_KEY=
EMAIL_FROM="Universident <no-reply@mail.universident.ro>"
