POSTGRES_PASSWORD=replace_with_a_secure_password

DATABASE_URL=postgresql://universident:replace_with_a_secure_password@localhost:5432/universident?schema=public

# Doar pentru Compose: setează după pregătirea rolului din ops/postgres/runtime-role.sql.
# Aplicația folosește această conexiune; migrările păstrează contul POSTGRES_USER.
APP_DATABASE_URL=

# Limite pentru VPS-ul de 8 GB RAM / 4 vCPU; nu rezervă memoria în avans.
APP_MEMORY_LIMIT=2g
APP_CPU_LIMIT=2.0
DB_MEMORY_LIMIT=3g
DB_CPU_LIMIT=2.0
CHAT_WORKER_MEMORY_LIMIT=384m
CHAT_WORKER_CPU_LIMIT=0.5

# Setează x-real-ip numai după ce proxy-ul suprascrie acest antet.
# Fără această opțiune, protecția publică globală rămâne activă.
PUBLIC_REQUEST_IP_HEADER=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret

# SEO: development / staging / production. NODE_ENV does not enable indexing.
# Set production only on the public site, with BETTER_AUTH_URL=https://universident.ro.
DEPLOYMENT_ENV=development

RESEND_API_KEY=
EMAIL_FROM="Universident <no-reply@mail.universident.ro>"

OPENAI_API_KEY=
# Chat : moderare și procesarea notificărilor.
OPENAI_MODERATION_MODEL=gpt-4.1-mini
CHAT_WORKER_SECRET=
CHAT_WORKER_URL=http://localhost:3000
